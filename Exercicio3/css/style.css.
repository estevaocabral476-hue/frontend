body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f4f7f9;
    color: #333333;
}

.container {
    width: 80%;
    max-width: 1100px;
    margin: 0 auto;
}

header {
    background-color: #0d6efd;
    color: white;
    padding: 20px 0;
}

nav {
    margin-top: 10px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-right: 20px;
    font-weight: bold;
}

nav a:hover {
    color: #ffd43b;
}

.secao {
    padding: 60px 0;
    margin-bottom: 20px;
}

#inicio {
    background-color: #e7f1ff;
    text-align: center;
    border-radius: 10px;
    padding: 60px 20px;
}

.botao-principal {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 24px;
    background-color: #ff9800;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
}

.botao-principal:hover {
    background-color: #e68900;
}

.card {
    background-color: white;
    padding: 20px;
    margin: 20px 0;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

#contato {
    background-color: #e7f1ff;
    border-radius: 10px;
    padding: 30px;
}

footer {
    background-color: #333333;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}    padding: 20px;
    background-color: #222;
    color: white;
}
